/* =========================================================
   UTILITÁRIOS
   ========================================================= */
function hojeISO(){
  const d = new Date();
  const off = d.getTimezoneOffset();
  return new Date(d.getTime() - off * 60000).toISOString().slice(0, 10);
}

function fmtData(iso){
  if (!iso) return '—';
  const [a, m, d] = iso.split('-');
  return `${d}/${m}/${a}`;
}

function definirData(iso){
  inData.value = iso || hojeISO();
  const [, mes, dia] = inData.value.split('-');
  btnCalendario.textContent = `${dia}/${mes}`;
  dataHint.textContent = '';
  if (calendario.classList.contains('show')) desenharCalendario(Number(dia));
}

inData.addEventListener('change', () => definirData(inData.value));
btnCalendario.addEventListener('click', () => {
  const [ano, mes, dia] = (inData.value || hojeISO()).split('-').map(Number);
  anoCalendario = ano;
  mesCalendario = mes - 1;
  desenharCalendario(dia);
  calendario.classList.toggle('show');
  calendarioBackdrop.classList.toggle('show', calendario.classList.contains('show'));
  btnCalendario.setAttribute('aria-expanded', calendario.classList.contains('show') ? 'true' : 'false');
});

function desenharCalendario(diaSelecionado){
  const primeiroDia = new Date(anoCalendario, mesCalendario, 1).getDay();
  const diasNoMes = new Date(anoCalendario, mesCalendario + 1, 0).getDate();
  const selecionada = (inData.value || hojeISO()).split('-').map(Number);
  const hoje = hojeISO().split('-').map(Number);
  const nomesMeses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  let html = `<div class="calendar-head">
    <button type="button" class="btn ghost calendar-nav" data-mes="-1" aria-label="Mês anterior">‹</button>
    <div class="calendar-month">${nomesMeses[mesCalendario]} ${anoCalendario}</div>
    <button type="button" class="btn ghost calendar-nav" data-mes="1" aria-label="Próximo mês">›</button>
  </div><div class="calendar-days">`;
  for (const nome of ['D','S','T','Q','Q','S','S']) html += `<div class="calendar-weekday">${nome}</div>`;
  for (let i = 0; i < primeiroDia; i++) html += '<span class="calendar-day empty"></span>';
  for (let d = 1; d <= diasNoMes; d++){
    const isSelected = d === (diaSelecionado || selecionada[2]) && mesCalendario + 1 === selecionada[1] && anoCalendario === selecionada[0];
    const isToday = d === hoje[2] && mesCalendario + 1 === hoje[1] && anoCalendario === hoje[0];
    html += `<button type="button" class="calendar-day${isSelected ? ' selected' : ''}${isToday ? ' today' : ''}" data-dia="${d}" aria-label="${d} de ${nomesMeses[mesCalendario]} de ${anoCalendario}">${d}</button>`;
  }
  calendario.innerHTML = html + '</div>';
}

calendario.addEventListener('click', e => {
  const nav = e.target.closest('[data-mes]');
  if (nav){
    mesCalendario += Number(nav.dataset.mes);
    if (mesCalendario < 0){mesCalendario = 11; anoCalendario--;}
    if (mesCalendario > 11){mesCalendario = 0; anoCalendario++;}
    desenharCalendario();
    return;
  }
  const botaoDia = e.target.closest('[data-dia]');
  if (!botaoDia) return;
  const dia = Number(botaoDia.dataset.dia);
  definirData(`${anoCalendario}-${String(mesCalendario + 1).padStart(2,'0')}-${String(dia).padStart(2,'0')}`);
  calendario.classList.remove('show');
  calendarioBackdrop.classList.remove('show');
  btnCalendario.setAttribute('aria-expanded','false');
});
calendarioBackdrop.addEventListener('click', () => {
  calendario.classList.remove('show');
  calendarioBackdrop.classList.remove('show');
  btnCalendario.setAttribute('aria-expanded','false');
});
function obterDataFormulario(){
  return inData.value || null;
}

function fmtNum(n){
  return Number(n || 0).toLocaleString('pt-BR');
}

function novoId(){
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

function atualizarVisualSelect(id){
  const select = $(id);
  const trigger = $(`${id}Trigger`);
  const options = $(`${id}Options`);
  if (!select || !trigger || !options) return;
  const valor = select.value;
  const option = [...select.options].find(o => o.value === valor);
  trigger.textContent = option?.textContent || (id === 'embalagem' ? 'Embalagem' : 'Bitola');
  options.querySelectorAll('.select-option').forEach(btn => {
    const selecionada = btn.dataset.value === valor;
    btn.classList.toggle('selected', selecionada);
    btn.setAttribute('aria-selected', selecionada ? 'true' : 'false');
  });
}

['embalagem','bitola'].forEach(id => {
  const trigger = $(`${id}Trigger`);
  const options = $(`${id}Options`);
  const select = $(id);
  trigger.addEventListener('click', () => {
    const abrir = !options.classList.contains('show');
    document.querySelectorAll('.select-options.show').forEach(menu => menu.classList.remove('show'));
    document.querySelectorAll('.select-trigger[aria-expanded="true"]').forEach(btn => btn.setAttribute('aria-expanded','false'));
    options.classList.toggle('show', abrir);
    trigger.setAttribute('aria-expanded', abrir ? 'true' : 'false');
  });
  options.addEventListener('click', e => {
    const opcao = e.target.closest('.select-option');
    if (!opcao) return;
    select.value = opcao.dataset.value;
    select.dispatchEvent(new Event('change', { bubbles: true }));
    atualizarVisualSelect(id);
    options.classList.remove('show');
    trigger.setAttribute('aria-expanded','false');
  });
  select.addEventListener('change', () => atualizarVisualSelect(id));
  atualizarVisualSelect(id);
});
