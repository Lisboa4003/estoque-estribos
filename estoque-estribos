$('btnExportarPDF').addEventListener('click', () => {
  const dados = dadosParaExportacao();
  if (!dados.length){
    alert('Não há registros para exportar com os filtros atuais.');
    return;
  }
  const popup = window.open('', '_blank');
  if (!popup){
    alert('O navegador bloqueou a janela do PDF. Permita pop-ups para este app e tente novamente.');
    return;
  }
  const escapeHtmlLocal = valor => String(valor ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const totalPecas = dados.reduce((soma, linha) => soma + (Number(linha[7]) || 0), 0);
  const totalPacotes = dados.reduce((soma, linha) => soma + (Number(linha[6]) || 0), 0);
  const linhas = dados.map((linha, index) => `<tr>${linha.map((valor, col) => `<td class="${col >= 5 ? 'num' : ''}">${escapeHtmlLocal(valor)}</td>`).join('')}</tr>`).join('');
  const cabecalhos = CABECALHOS_EXPORTACAO.map(h => `<th>${escapeHtmlLocal(h)}</th>`).join('');
  const filtros = fBusca.value.trim() ? `Pesquisa: ${escapeHtmlLocal(fBusca.value.trim())}` : 'Todos os registros';
  popup.document.write(`<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Relatório de Estoque</title><style>
    :root{color-scheme:light}*{box-sizing:border-box}body{font:11px Arial,Helvetica,sans-serif;color:#172033;margin:0;background:#fff}.page{max-width:1400px;margin:0 auto;padding:28px 30px}.top{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #ea580c;padding-bottom:14px;margin-bottom:18px}.brand{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#c2410c;font-weight:700;margin-bottom:5px}h1{font-size:24px;letter-spacing:.4px;margin:0;color:#0f172a}.subtitle{font-size:11px;color:#64748b;margin-top:5px}.date{text-align:right;color:#475569;font-size:10px}.cards{display:flex;gap:10px;margin:16px 0 20px}.card{flex:1;border:1px solid #e2e8f0;border-radius:8px;padding:11px 13px;background:#f8fafc}.card label{display:block;font-size:9px;letter-spacing:.7px;text-transform:uppercase;color:#64748b;font-weight:700}.card strong{display:block;font-size:18px;margin-top:5px;color:#0f172a}.section-title{font-size:12px;font-weight:700;margin:18px 0 8px}.meta{font-size:10px;color:#64748b;margin-bottom:8px}table{width:100%;border-collapse:collapse;table-layout:auto}thead{display:table-header-group}th{background:#f1f5f9;color:#475569;text-align:left;font-size:8px;letter-spacing:.4px;text-transform:uppercase;padding:9px 7px;border-bottom:2px solid #cbd5e1}td{padding:8px 7px;border-bottom:1px solid #e8edf3;font-size:9px}tbody tr:nth-child(even){background:#fafbfc}tbody tr{page-break-inside:avoid}.num{text-align:right;font-variant-numeric:tabular-nums}.total-row td{background:#fff7ed;border-top:2px solid #ea580c;font-weight:700;color:#9a3412}.footer{margin-top:18px;padding-top:8px;border-top:1px solid #e2e8f0;color:#94a3b8;font-size:9px;display:flex;justify-content:space-between}.print{position:fixed;top:14px;right:14px;border:0;border-radius:6px;background:#ea580c;color:white;padding:10px 15px;font-weight:700;cursor:pointer}@page{size:landscape;margin:12mm}@media print{.page{padding:0;max-width:none}.print{display:none}.card{background:#f8fafc!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}th{background:#f1f5f9!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}}
    </style></head><body><button class="print" onclick="window.print()">Salvar como PDF</button><main class="page"><header class="top"><div><div class="brand">Controle de estoque</div><h1>ESTOQUE</h1><div class="subtitle">Relatório de entradas de estribos</div></div><div class="date"><strong>Emitido em</strong><br>${escapeHtmlLocal(fmtData(hojeISO()))}</div></header><section class="cards"><div class="card"><label>Registros</label><strong>${dados.length}</strong></div><div class="card"><label>Pacotes</label><strong>${fmtNum(totalPacotes)}</strong></div><div class="card"><label>Total de peças</label><strong>${fmtNum(totalPecas)}</strong></div></section><div class="section-title">Movimentações registradas</div><div class="meta">${filtros}</div><table><thead><tr>${cabecalhos}</tr></thead><tbody>${linhas}<tr class="total-row"><td colspan="6">Totais</td><td class="num">${fmtNum(totalPacotes)}</td><td class="num">${fmtNum(totalPecas)}</td></tr></tbody></table><footer class="footer"><span>ESTOQUE · Controle de entradas</span><span>${dados.length} registros</span></footer></main><script>window.addEventListener('load',()=>setTimeout(()=>window.print(),300));<\/script></body></html>`);
