<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ESTOQUE</title>
<style>
  :root{
    --bg:#f4f6f9;
    --card:#ffffff;
    --ink:#0f172a;
    --muted:#64748b;
    --line:#e2e8f0;
    --accent:#ea580c;
    --accent-dark:#c2410c;
    --green:#0f766e;
    --red:#dc2626;
    --radius:12px;
    --shadow:0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
    background:var(--bg);
    color:var(--ink);
    padding:20px 16px 60px;
  }
  .wrap{max-width:1180px;margin:0 auto}
  .login-card{max-width:440px;margin:7vh auto 0}
  .login-card h2{color:var(--ink);text-transform:none;letter-spacing:0;font-size:1.15rem}
  .login-card input{width:100%;padding:12px;border:1px solid var(--line);border-radius:9px;font:inherit;margin:6px 0 12px}
  .login-status{min-height:1.2em;color:var(--red);font-size:.85rem}
  .session-bar{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-bottom:12px;color:var(--muted);font-size:.82rem}

  header.top{
    display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;
    margin-bottom:20px;
  }
  header.top h1{
    font-size:1.45rem;margin:0;letter-spacing:-.02em;
    display:flex;align-items:center;gap:10px;
  }

  .card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:18px;margin-bottom:18px;
  }
  .form-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}
  .form-heading h2{margin:0;padding-top:8px}
  .date-field{position:relative;display:flex;flex-direction:column;align-items:flex-end;gap:5px;min-width:0}
  .date-field label{font-size:.74rem;font-weight:600;color:var(--muted)}
  .date-field .calendar-popup{position:fixed;top:50%;left:50%;right:auto;z-index:1002;transform:translate(-50%,-50%);width:min(360px,calc(100vw - 32px));max-width:none;margin:0}
  .calendar-backdrop{display:none;position:fixed;inset:0;z-index:1001;background:rgba(15,23,42,.38)}
  .calendar-backdrop.show{display:block}
  @media (max-width:520px){.form-heading{gap:8px}.form-heading h2{font-size:.78rem}}
  .card h2{
    font-size:.95rem;text-transform:uppercase;letter-spacing:.06em;
    color:var(--muted);margin:0 0 14px;font-weight:700;
  }

  /* ---------- Formulário ---------- */
  .grid{
    display:grid;gap:14px;
    grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  }
  .field{display:flex;flex-direction:column;gap:6px}
  .cadastro-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  @media (max-width:520px){.cadastro-grid{grid-template-columns:1fr}}
  .field label{font-size:.8rem;font-weight:600;color:#334155}
  .field input,.field select{
    padding:10px 12px;border:1px solid var(--line);border-radius:9px;
    font-size:.92rem;font-family:inherit;background:#fff;color:var(--ink);
    transition:border-color .15s, box-shadow .15s;width:100%;
    color-scheme:light;accent-color:var(--accent);
  }
  .field input:focus,.field select:focus,.filters input:focus,.filters select:focus{
    outline:none;border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(234,88,12,.15);
  }
  .field select,.filters select{accent-color:var(--accent)}
  .field select option,.filters select option{background:#fff;color:var(--ink)}
  .field select option:checked,.filters select option:checked{background:var(--accent);color:#fff}
  input[type="date"]{background-color:#fff;color:var(--ink)}
  input[type="date"]::-webkit-calendar-picker-indicator{opacity:.55;filter:sepia(1) saturate(5) hue-rotate(345deg);width:14px;height:14px;cursor:pointer}
  input[type="date"]::-webkit-calendar-picker-indicator:hover{opacity:.9}
  ::selection{background:rgba(234,88,12,.2);color:var(--ink)}
  .data-controls{display:flex;align-items:center;gap:6px}
  .data-picker-btn{min-width:116px;justify-content:center;padding:11px 14px;font-size:.95rem}
  .calendar-popup{display:none;margin-top:8px;padding:16px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow);width:320px;max-width:min(320px,calc(100vw - 40px))}
  .calendar-popup.show{display:block}
  .calendar-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
  .calendar-month{font-weight:700;text-align:center;flex:1;font-size:1rem}
  .calendar-nav{padding:9px 12px;font-size:1rem;min-width:42px;justify-content:center}
  .calendar-days{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center}
  .calendar-weekday{font-size:.78rem;font-weight:700;color:var(--muted);padding:7px 0}
  .calendar-day{border:0;border-radius:9px;background:#fff;color:var(--ink);padding:10px 0;min-height:42px;font:inherit;font-size:.94rem;cursor:pointer}
  .calendar-day:hover{background:#fff7ed;color:var(--accent-dark)}
  .calendar-day.selected{background:var(--accent);color:#fff;font-weight:700}
  .calendar-day.today{outline:1px solid var(--accent)}
  .calendar-day.empty{visibility:hidden;pointer-events:none;padding:0}
  .calendar-day:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
  .date-native-picker{display:none}
  .custom-select{position:relative}
  .select-trigger{width:100%;justify-content:space-between;text-align:left;background:#fff;border-color:var(--line);color:var(--ink)}
  .select-trigger:hover,.select-trigger[aria-expanded="true"]{border-color:var(--accent);background:#fff7ed}
  .select-options{display:none;position:absolute;z-index:20;top:calc(100% + 5px);left:0;right:0;padding:8px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow);max-height:280px;overflow-y:auto}
  .select-options.show{display:block}
  .select-option{display:block;width:100%;min-height:48px;padding:12px 14px;border:0;border-radius:9px;background:#fff;color:var(--ink);font:inherit;font-size:.98rem;text-align:left;cursor:pointer}
  .select-option:hover,.select-option:focus{background:#fff7ed;color:var(--accent-dark);outline:none}
  .select-option.selected{background:var(--accent);color:#fff;font-weight:700}
  .field small{font-size:.72rem;color:var(--muted);min-height:1em}
  .suggestions{display:none;border:1px solid var(--line);border-radius:9px;background:#fff;box-shadow:var(--shadow);max-height:180px;overflow-y:auto;margin-top:-2px}
  .suggestions.show{display:block}
  .suggestion{display:block;width:100%;padding:9px 12px;border:0;background:#fff;text-align:left;font:inherit;color:var(--ink);cursor:pointer}
  .suggestion:hover,.suggestion:focus{background:#f8fafc;outline:none}

  .actions{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;align-items:center}
  #salvamentoStatus{font-size:.78rem;min-height:1em}
  .btn{
    border:1px solid transparent;border-radius:9px;padding:10px 18px;
    font-size:.9rem;font-weight:600;font-family:inherit;cursor:pointer;
    transition:.15s;display:inline-flex;align-items:center;gap:7px;
  }
  .btn.primary{background:var(--accent);color:#fff}
  .btn.primary:hover{background:var(--accent-dark)}
  .btn.ghost{background:#fff;border-color:var(--line);color:#334155}
  .btn.ghost:hover{background:#f8fafc}
  .btn.danger{background:#fff;border-color:#fecaca;color:var(--red)}
  .btn.danger:hover{background:#fef2f2}

  /* ---------- Cards resumo ---------- */
  .stats{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:18px}
  .stat{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:16px 18px;box-shadow:var(--shadow);
  }
  .stat .lbl{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:700}
  .stat .val{font-size:1.6rem;font-weight:800;letter-spacing:-.02em;margin-top:4px}
  .stat .val small{font-size:.75rem;font-weight:600;color:var(--muted);letter-spacing:0}
  .stat.in .val{color:var(--green)}

  /* ---------- Filtros ---------- */
  .filters{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .filters input,.filters select{
    padding:9px 12px;border:1px solid var(--line);border-radius:9px;
    font-size:.88rem;font-family:inherit;background:#fff;color:var(--ink);
  }
  .filters input{flex:1;min-width:170px}
  .filters input:focus,.filters select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(234,88,12,.15)}
  .filters .spacer{flex:1}
  .report-menu{position:relative;display:flex;align-items:center}
  .report-options{display:none;position:fixed;z-index:1000;left:12px;top:12px;right:auto;width:min(260px,calc(100vw - 24px));padding:10px;border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow)}
  .report-options.show{display:flex;flex-direction:column;gap:7px;align-items:stretch}
  .report-option{display:flex;width:100%;min-height:48px;box-sizing:border-box;justify-content:flex-start;text-align:left;padding:12px 14px;margin:0;font-size:.95rem;white-space:nowrap}

  /* ---------- Tabela ---------- */
  .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
  table{width:100%;border-collapse:collapse;font-size:.88rem;min-width:980px}
  thead th{
    background:#f8fafc;text-align:left;padding:11px 12px;font-size:.74rem;
    text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
    border-bottom:1px solid var(--line);white-space:nowrap;
  }
  tbody td{padding:11px 12px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
  tbody tr:last-child td{border-bottom:none}
  tbody tr:hover{background:#fafbfc}
  .num{text-align:right;font-variant-numeric:tabular-nums;font-weight:700}
  .qtd-in{color:var(--green)}

  .badge{
    display:inline-block;padding:3px 9px;border-radius:999px;
    font-size:.72rem;font-weight:700;white-space:nowrap;
  }
  .b-pacote{background:#e0f2fe;color:#0369a1}
  .b-amarrado{background:#ede9fe;color:#6d28d9}
  .b-caixa{background:#dcfce7;color:#15803d}
  .b-mercadoLivre{background:#fef3c7;color:#b45309}

  .row-actions{display:flex;gap:6px}
  .row-action{padding:6px 9px;font-size:.78rem}

  .empty{padding:34px;text-align:center;color:var(--muted);font-size:.9rem}

  /* ---------- Saldo ---------- */
  .saldo-grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}

  @media (max-width:520px){
    body{padding:14px 10px 40px}
    header.top h1{font-size:1.2rem}
  }
</style>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
</head>
<body>
<div class="wrap">
  <section class="card login-card" id="loginCard">
    <h2>Acesso ao ESTOQUE</h2>
    <p>Entre com seu e-mail autorizado para acessar e sincronizar os registros.</p>
    <form id="loginForm" autocomplete="on">
      <label for="loginEmail">E-mail</label>
      <input id="loginEmail" type="email" autocomplete="username" required value="fernando@lisboa.com">
      <label for="loginPassword">Senha</label>
      <input id="loginPassword" type="password" autocomplete="current-password" required>
      <button class="btn primary" id="btnLogin" type="submit">Entrar</button>
      <div class="login-status" id="loginStatus" role="status" aria-live="polite"></div>
    </form>
  </section>
  <div id="appContent" hidden>
    <div class="session-bar"><span id="sessionEmail"></span><button class="btn ghost" id="btnLogout" type="button">Sair</button></div>
  <header class="top">
    <div>
      <h1>ESTOQUE</h1>
    </div>
  </header>

  <!-- ================= CADASTRO ================= -->
  <section class="card">
    <div class="form-heading">
      <h2 id="formTitulo">Registro</h2>
      <div class="date-field">
        <div class="data-controls">
          <button class="btn ghost data-picker-btn" id="btnCalendario" type="button" aria-label="Selecionar data" aria-expanded="false">dd/mm</button>
          <input id="data" class="date-native-picker" type="date" tabindex="-1" aria-hidden="true">
        </div>
        <div id="calendarioBackdrop" class="calendar-backdrop"></div>
        <div id="calendario" class="calendar-popup" aria-label="Selecionar data"></div>
        <small id="dataHint"></small>
      </div>
    </div>
    <form id="form" autocomplete="off">
      <div class="grid cadastro-grid">

        <div class="field">
          <input id="nome" required placeholder="Peça" aria-label="Peça">
          <small></small>
        </div>

        <div class="field">
          <div class="custom-select" data-select="embalagem">
            <button class="btn ghost select-trigger" id="embalagemTrigger" type="button" aria-haspopup="listbox" aria-expanded="false">Embalagem</button>
            <div class="select-options" id="embalagemOptions" role="listbox">
              <button class="select-option" type="button" data-value="pacote" role="option">Pacote</button>
              <button class="select-option" type="button" data-value="amarrado" role="option">Amarrado</button>
              <button class="select-option" type="button" data-value="caixa" role="option">Caixa</button>
              <button class="select-option" type="button" data-value="mercadoLivre" role="option">Mercado Livre</button>
            </div>
            <select id="embalagem" aria-hidden="true" tabindex="-1" style="display:none">
              <option value="">Embalagem</option><option value="pacote">Pacote</option><option value="amarrado">Amarrado</option><option value="caixa">Caixa</option><option value="mercadoLivre">Mercado Livre</option>
            </select>
          </div>
          <small id="embHint"></small>
        </div>

        <div class="field">
          <div class="custom-select" data-select="bitola">
            <button class="btn ghost select-trigger" id="bitolaTrigger" type="button" aria-haspopup="listbox" aria-expanded="false">Bitola</button>
            <div class="select-options" id="bitolaOptions" role="listbox">
              <button class="select-option" type="button" data-value="3.8" role="option">3.8 mm</button>
              <button class="select-option" type="button" data-value="4.2" role="option">4.2 mm</button>
              <button class="select-option" type="button" data-value="5.0" role="option">5.0 mm</button>
              <button class="select-option" type="button" data-value="6.0" role="option">6.0 mm</button>
            </div>
            <select id="bitola" aria-hidden="true" tabindex="-1" style="display:none">
              <option value="">Bitola</option><option value="3.8">3.8 mm</option><option value="4.2">4.2 mm</option><option value="5.0">5.0 mm</option><option value="6.0">6.0 mm</option>
            </select>
          </div>
          <small></small>
        </div>

        <div class="field">
          <input id="quantidade" type="number" min="1" step="1" required placeholder="Quant/peças — peças por pacote" aria-label="Quant/peças, peças por pacote">
          <small id="qtdHint">Peças em cada pacote.</small>
        </div>

        <div class="field">
          <input id="quantidadePacotes" type="number" min="1" step="1" required placeholder="Quant/pacote" aria-label="Quant/pacote">
          <small id="totalHint"></small>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="btn primary" id="btnSalvar">Registrar</button>
        <small id="salvamentoStatus" role="status" aria-live="polite"></small>
      </div>
    </form>
  </section>

  <!-- ================= RESUMO ================= -->
  <div class="stats">
    <div class="stat in">
      <div class="lbl">Total de peças registradas</div>
      <div class="val" id="statSaldo">0 <small>peças</small></div>
    </div>
    <div class="stat">
      <div class="lbl">Pacotes registrados</div>
      <div class="val" id="statPacotes">0</div>
    </div>
    <div class="stat">
      <div class="lbl">Registros</div>
      <div class="val" id="statRegistros">0</div>
    </div>
  </div>

  <!-- ================= ENTRADAS REGISTRADAS ================= -->
  <section class="card">
    <h2>Entradas registradas</h2>

    <div class="filters" style="margin-bottom:14px">
      <input id="fBusca" type="search" placeholder="Buscar em todos os campos…">
      <div class="spacer"></div>
      <div class="report-menu">
        <button class="btn ghost" id="btnRelatorio" type="button" aria-haspopup="true" aria-expanded="false">Relatório</button>
        <div class="report-options" id="opcoesRelatorio">
          <button class="btn ghost report-option" id="btnExportarPDF" type="button">Exportar PDF</button>
          <button class="btn ghost report-option" id="btnExportarExcel" type="button">Exportar Excel</button>
          <button class="btn danger report-option" id="btnLimpar" type="button">Limpar tudo</button>
        </div>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Operador</th>
            <th>Peça</th>
            <th>Embalagem</th>
            <th>Bitola</th>
            <th style="text-align:right">Quant/peças</th>
            <th style="text-align:right">Quant/pacote</th>
            <th style="text-align:right">Total de peças</th>
            <th style="text-align:center">Ações</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div class="empty" id="vazio" hidden>Nenhum registro encontrado.</div>
  </section>
  </div>
</div>

<script>
/* =========================================================
   CONFIGURAÇÃO DAS EMBALAGENS
   ========================================================= */
const EMBALAGENS = {
  pacote: {
    label: 'Pacote',
    qtdPadrao: 500,
    hint: 'Padrão: 500 peças por pacote (editável).'
  },
  amarrado: {
    label: 'Amarrado',
    qtdPadrao: null,
    hint: 'Quantidade livre — sem padrão definido.'
  },
  caixa: {
    label: 'Caixa',
    qtdPadrao: 250,
    hint: 'Padrão: 250 peças por pacote (editável).'
  },
  mercadoLivre: {
    label: 'Mercado Livre',
    qtdPadrao: 100,
    hint: 'Padrão: 100 peças por pacote (editável).'
  }
};

const STORAGE_KEY = 'estoque_estribos_v1';
const OPERADOR_FIXO = 'Fernando';
const FIREBASE_CONFIG = {
  apiKey: 'AIzaSyB55UkbGsFYkUfzyyaEOpbw6lUnQmMtZus',
  authDomain: 'estoque-b4865.firebaseapp.com',
  databaseURL: 'https://estoque-b4865-default-rtdb.firebaseio.com',
  projectId: 'estoque-b4865',
  storageBucket: 'estoque-b4865.firebasestorage.app',
  messagingSenderId: '659165960240',
  appId: '1:659165960240:web:55e0516034341abff1f5f5',
  measurementId: 'G-H64KCY1C4J'
};
const firebaseApp = firebase.initializeApp(FIREBASE_CONFIG);
const auth = firebase.auth();
const db = firebase.firestore();
let usuarioAtual = null;
let dadosProntos = false;

/* =========================================================
   ESTADO
   ========================================================= */
let registros = carregar().map(r => ({ ...r, operador: OPERADOR_FIXO }));
let editandoId = null;

/* =========================================================
   ATALHOS DOM
   ========================================================= */
const $ = (id) => document.getElementById(id);

const loginCard = $('loginCard');
const loginForm = $('loginForm');
const loginStatus = $('loginStatus');
const appContent = $('appContent');
const sessionEmail = $('sessionEmail');
const form       = $('form');
const inNome     = $('nome');
const inBitola   = $('bitola');
const inEmb      = $('embalagem');
const inQtd      = $('quantidade');
const inQtdPacotes = $('quantidadePacotes');
const totalHint  = $('totalHint');
const inData     = $('data');
const btnCalendario = $('btnCalendario');
const dataHint   = $('dataHint');
const calendario = $('calendario');
const calendarioBackdrop = $('calendarioBackdrop');
const embHint    = $('embHint');
let mesCalendario = new Date().getMonth();
let anoCalendario = new Date().getFullYear();
const qtdHint    = $('qtdHint');
const btnSalvar  = $('btnSalvar');
const salvamentoStatus = $('salvamentoStatus');
const formTitulo = $('formTitulo');

const tbody      = $('tbody');
const vazio      = $('vazio');

const fBusca     = $('fBusca');

/* =========================================================
   PERSISTÊNCIA
   ========================================================= */
function carregar(){
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    const arr = raw ? JSON.parse(raw) : [];
    return Array.isArray(arr) ? arr : [];
  } catch (e) {
    console.warn('Falha ao carregar dados locais:', e);
    return [];
  }
}

async function salvarStorage(){
  if (!usuarioAtual || !dadosProntos) throw new Error('Entre na sua conta antes de salvar.');
  const batch = db.batch();
  registros.forEach(r => {
    const ref = db.collection('registros').doc(String(r.id));
    batch.set(ref, { ...r, operador: OPERADOR_FIXO, uid: usuarioAtual.uid }, { merge: true });
  });
  await batch.commit();
  localStorage.setItem(STORAGE_KEY, JSON.stringify(registros));
}

async function carregarRegistrosDaNuvem(user){
  const snapshot = await db.collection('registros').where('uid', '==', user.uid).get();
  if (snapshot.empty){
    const locais = carregar().map(r => ({ ...r, operador: OPERADOR_FIXO }));
    registros = locais;
    dadosProntos = true;
    if (locais.length) await salvarStorage();
  } else {
    registros = snapshot.docs.map(doc => ({ ...doc.data(), id: doc.id, operador: OPERADOR_FIXO }));
    localStorage.setItem(STORAGE_KEY, JSON.stringify(registros));
  }
  dadosProntos = true;
  render();
}

loginForm.addEventListener('submit', async e => {
  e.preventDefault();
  loginStatus.textContent = 'Entrando…';
  try {
    await auth.signInWithEmailAndPassword($('loginEmail').value.trim(), $('loginPassword').value);
  } catch (err) {
    console.error('Falha no login Firebase:', err);
