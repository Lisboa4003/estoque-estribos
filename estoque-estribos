/* =========================================================
   FORMULÁRIO — SALVAR / EDITAR / CANCELAR
   ========================================================= */
form.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!usuarioAtual || !dadosProntos){ alert('Aguarde a conexão com o Firebase antes de registrar.'); return; }
  const registrosAntes = [...registros];

  const operador  = OPERADOR_FIXO;
  const nome      = inNome.value.trim();
  const bitola    = inBitola.value;
  const embalagem = inEmb.value;
  const quantidade= Number(inQtd.value);
  const quantidadePacotes = Number(inQtdPacotes.value);
  const data      = obterDataFormulario();

  if (!nome || !bitola || !embalagem || !data){
    alert('Preencha data, peça, embalagem e bitola.');
    return;
  }
  if (!Number.isInteger(quantidade) || quantidade <= 0){
    alert('Informe a quantidade de peças por pacote (maior que zero).');
    return;
  }
  if (!Number.isInteger(quantidadePacotes) || quantidadePacotes <= 0){
    alert('Informe uma quantidade de pacotes válida (maior que zero).');
    return;
  }
  const totalPecas = quantidade * quantidadePacotes;

  if (editandoId){
    const idx = registros.findIndex(r => r.id === editandoId);
    if (idx > -1){
      registros[idx] = {
        ...registros[idx],
        operador, nome, embalagem, bitola, quantidade, quantidadePorPacote: quantidade, quantidadePacotes, totalPecas, data,
        atualizadoEm: new Date().toISOString()
      };
    }
    encerrarEdicao();
  } else {
    registros.push({
      id: novoId(),
      operador, nome, embalagem, bitola, quantidade, quantidadePorPacote: quantidade, quantidadePacotes, totalPecas, data,
      criadoEm: new Date().toISOString()
    });
  }

  try {
    await salvarStorage();
    salvamentoStatus.textContent = 'Registro salvo e sincronizado com o Firebase.';
    salvamentoStatus.style.color = 'var(--green)';
    limparFormulario();
    render();
  } catch (err) {
    console.error('Falha ao salvar registro no Firebase:', err);
    registros = registrosAntes;
    salvamentoStatus.textContent = 'Não foi possível salvar no Firebase. Os dados do formulário foram mantidos.';
    salvamentoStatus.style.color = 'var(--red)';
    render();
  }
});

function limparFormulario(){
  inNome.value = '';
  inQtd.value  = '';
  inQtdPacotes.value = '';
  definirData(hojeISO());
  qtdHint.textContent = '';
  totalHint.textContent = '';
  // mantém o tipo de embalagem para agilizar lançamentos em sequência
}

function iniciarEdicao(id){
  const r = registros.find(x => x.id === id);
  if (!r) return;

  editandoId = id;
  inNome.value     = r.nome;
  inBitola.value   = r.bitola || '';
  inEmb.value      = r.embalagem;
  atualizarVisualSelect('bitola');
  atualizarVisualSelect('embalagem');
  inQtd.value      = r.quantidadePorPacote ?? r.quantidade ?? '';
  inQtdPacotes.value = r.quantidadePacotes ?? 1;
  definirData(r.data || hojeISO());

  const cfg = EMBALAGENS[r.embalagem];
  embHint.textContent = cfg ? cfg.hint : '';
  qtdHint.textContent = '';
  atualizarTotal();

  formTitulo.textContent = 'Editando registro';
  btnSalvar.textContent  = 'Salvar alterações';

  form.scrollIntoView({ behavior: 'smooth', block: 'center' });
  inNome.focus();
}

function encerrarEdicao(){
  editandoId = null;
  formTitulo.textContent = 'Registro';
  btnSalvar.textContent  = 'Registrar';
}

/* =========================================================
   TABELA — AÇÕES
   ========================================================= */
tbody.addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-acao]');
  if (!btn) return;

  const id = btn.dataset.id;

  if (btn.dataset.acao === 'editar'){
    iniciarEdicao(id);
  }

  if (btn.dataset.acao === 'excluir'){
    const r = registros.find(x => x.id === id);
    if (!r) return;
    if (confirm(`Excluir o registro de "${r.nome}" (${fmtNum(r.quantidade)} peças)?`)){
      const antes = [...registros];
      registros = registros.filter(x => x.id !== id);
      if (editandoId === id) { encerrarEdicao(); form.reset(); atualizarVisualSelect('embalagem'); atualizarVisualSelect('bitola'); definirData(hojeISO()); }
      try { await db.collection('registros').doc(String(id)).delete(); await salvarStorage(); render(); }
      catch (err) { console.error('Falha ao excluir no Firebase:', err); registros = antes; alert('Não foi possível excluir no Firebase. Confira a conexão e as regras.'); render(); }
    }
  }
});

/* =========================================================
   FILTROS
   ========================================================= */
fBusca.addEventListener('input', render);

function registrosFiltrados(){
  const q = fBusca.value.trim().toLocaleLowerCase('pt-BR');

  return registros.filter(r => {
    if (q){
      const quantidade = Number(r.quantidadePorPacote ?? r.quantidade) || 0;
      const pacotes = Number(r.quantidadePacotes) || 1;
      const total = Number(r.totalPecas) || quantidade * pacotes;
      const campos = [
        fmtData(r.data),
        r.data,
        r.operador || OPERADOR_FIXO,
        r.nome,
        EMBALAGENS[r.embalagem]?.label || r.embalagem,
        r.embalagem,
        r.bitola ? `${r.bitola} mm` : '',
        r.bitola,
        quantidade,
        fmtNum(quantidade),
        pacotes,
        fmtNum(pacotes),
        total,
        fmtNum(total)
      ];
      const txt = campos.join(' ').toLocaleLowerCase('pt-BR');
      if (!txt.includes(q)) return false;
    }
    return true;
  }).sort((a, b) => {
    const d = (b.data || '').localeCompare(a.data || '');
    if (d !== 0) return d;
    return (b.criadoEm || '').localeCompare(a.criadoEm || '');
  });
}

/* =========================================================
   RENDERIZAÇÃO
   ========================================================= */
function render(){
  renderTabela();
  renderStats();
}

function renderTabela(){
  const lista = registrosFiltrados();
  tbody.innerHTML = '';

  vazio.hidden = lista.length > 0;

  const frag = document.createDocumentFragment();

  lista.forEach(r => {
    const cfg = EMBALAGENS[r.embalagem] || { label: r.embalagem };
    const tr = document.createElement('tr');


    const pecasPorPacote = Number(r.quantidadePorPacote ?? r.quantidade) || 0;
    const qtdPacotes = Number(r.quantidadePacotes) || 1;
    const totalPecas = Number(r.totalPecas) || pecasPorPacote * qtdPacotes;

    tr.innerHTML = `
      <td>${fmtData(r.data)}</td>
      <td>${escapeHtml(r.operador)}</td>
      <td>${escapeHtml(r.nome)}</td>
      <td><span class="badge b-${r.embalagem}">${escapeHtml(cfg.label)}</span></td>
      <td>${r.bitola ? `${escapeHtml(r.bitola)} mm` : '—'}</td>
      <td class="num">${fmtNum(pecasPorPacote)}</td>
      <td class="num">${fmtNum(qtdPacotes)}</td>
      <td class="num qtd-in">${fmtNum(totalPecas)}</td>
      <td>
        <div class="row-actions" style="justify-content:center">
          <button class="btn ghost row-action" data-acao="editar" data-id="${r.id}" type="button">Editar</button>
          <button class="btn danger row-action" data-acao="excluir" data-id="${r.id}" type="button">Excluir</button>
        </div>
      </td>
    `;
    frag.appendChild(tr);
  });

  tbody.appendChild(frag);
}

function renderStats(){
  const total = registros.reduce((soma, r) => soma + (Number(r.totalPecas) || (Number(r.quantidadePorPacote ?? r.quantidade) || 0) * (Number(r.quantidadePacotes) || 1)), 0);
  const pacotes = registros.reduce((soma, r) => soma + (Number(r.quantidadePacotes) || 1), 0);

  $('statSaldo').innerHTML       = `${fmtNum(total)} <small>peças</small>`;
  $('statPacotes').textContent   = fmtNum(pacotes);
  $('statRegistros').textContent = fmtNum(registros.length);
}


function escapeHtml(s){
  return String(s ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

