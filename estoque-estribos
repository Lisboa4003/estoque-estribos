    return [
      fmtData(r.data),
      r.operador || OPERADOR_FIXO,
      r.nome,
      EMBALAGENS[r.embalagem]?.label || r.embalagem,
      r.bitola ? `${r.bitola} mm` : '',
      pecas,
      pacotes,
      Number(r.totalPecas) || pecas * pacotes
    ];
  });
}

