$('btnLimpar').addEventListener('click', async () => {
  if (!registros.length){
    alert('Não há registros para limpar.');
    return;
  }
  if (!confirm('Isso vai apagar TODOS os registros do estoque. Deseja continuar?')) return;
  if (!confirm('Confirmação final: apagar todos os registros permanentemente?')) return;

  const anteriores = [...registros];
  registros = [];
  encerrarEdicao();
  try { const snap = await db.collection('registros').where('uid','==',usuarioAtual.uid).get(); const batch = db.batch(); snap.docs.forEach(doc => batch.delete(doc.ref)); await batch.commit(); localStorage.setItem(STORAGE_KEY, '[]'); render(); }
  catch (err) { console.error('Falha ao limpar Firebase:', err); registros = anteriores; alert('Não foi possível limpar os registros no Firebase.'); render(); }
});

